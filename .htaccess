RewriteEngine On

# ---------------------------------------------------
# FORCE old slug → new slug (absolute match)
# ---------------------------------------------------
RewriteRule ^jamna-bader-first-female-padi-instructor-lakshadweep\.html$ /first-female-padi-scuba-diving-instructor-lakshadweep [R=301,L]
RewriteRule ^jamna-bader-first-female-padi-instructor-lakshadweep/?$ /first-female-padi-scuba-diving-instructor-lakshadweep [R=301,L]

# ---------------------------------------------------
# Redirect .html → extensionless
# ---------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# ---------------------------------------------------
# Serve .html internally
# ---------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
